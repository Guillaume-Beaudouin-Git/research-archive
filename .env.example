# ─────────────────────────────────────────────────────────────────────────────
# Algo_claude — .env template
#
# Copy this file to `.env` (gitignored), then fill in real values.
# NEVER commit `.env`. NEVER paste real values in cron lines, scripts, or chat.
#
# Variables below are verified consumed by the codebase via grep `os.getenv` /
# `os.environ` (see _audit/verification_2026-05-30.md V11). MT5_* are imported
# from Futures/live/strategy_c_live/config.py and consumed by mt5_client.py /
# validate_mt5.py (legacy FTMO US100 CFD path; not used by current Tradovate
# pipeline but kept for backward compat).
#
# Pattern in VPS cron jobs: `source ~/projects/Algo_claude/.env && python ...`
# — see _audit/security_cleanup_2026-05-30.md S1.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram alerting ───────────────────────────────────────────────────────
# Consumed by: notifier.py, daily_summary.py, monitor_loop.py,
#   Futures/live/strategy_c_live/guardrails.py, run_daily.py
# Get token from @BotFather; chat ID from @userinfobot.
# For a private channel/group, the ID is negative (-100…).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Hyperliquid (Strategies A + B) ──────────────────────────────────────────
# TESTNET key — used by Strategy A daily HL testnet runner (tsmom_live.py)
# AND Strategy B delta-neutral live (strategies/delta_neutral/live_trader.py).
# Hex string, with or without 0x prefix.
HYPERLIQUID_TESTNET_KEY=
# MAINNET key — only set when Strategy B mainnet deployment is approved
# (~2026-07-17, after 60-day testnet validation). NEVER reuse testnet key.
# Currently referenced only in docs/.env.example, no live consumer.
HYPERLIQUID_PRIVATE_KEY=

# ── Binance testnet (Strategy B spot leg) ───────────────────────────────────
# Consumed by: strategies/delta_neutral/live_trader.py:800-801
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=

# ── Propr (Strategy A — FROZEN 2026-05-30, kept for cron weekly rebalance) ──
# Consumed by: strategies/tsmom_v2_propfirm/execution/propr_sdk.py:61,64,
#   run_rebalance.py:44, daily_summary.py:160, discover_api.py:25
# pk_live_* for live, pk_test_* for testnet. Rotate after ANY exposure.
PROPR_API_KEY=
# Optional URL override. Defaults baked into propr_sdk.py:64. Leave blank
# unless Propr support specifies a non-default endpoint.
PROPR_API_URL=

# ── Tradovate (Strategy C — Tradeify Select Flex $25K paper) ────────────────
# Consumed by: Futures/live/strategy_c_live/config.py:44-51
# Phase: 'demo' (default) or 'live'.
TRADOVATE_ENV=demo
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_CID=
TRADOVATE_SECRET=
# App identification — defaults exist in config.py; override only if
# Tradovate instructs.
TRADOVATE_APP_ID=StratC
TRADOVATE_APP_VERSION=1.0
TRADOVATE_DEVICE_ID=

# ── MT5 (legacy FTMO US100 CFD path, Strategy A early research) ─────────────
# Consumed by: Futures/live/strategy_c_live/mt5_client.py:48-50 (via
#   config.py import), validate_mt5.py. Strategy C now runs via Tradovate;
#   MT5_* are kept because the import path still resolves and validate_mt5.py
#   continues to exist as a sanity-check tool.
MT5_SERVER=
MT5_LOGIN=
MT5_PASSWORD=

# ── Data providers (research only) ──────────────────────────────────────────
# FRED (data/cache.py:284) — daily risk-free rate (DTB3). Free at fred.stlouisfed.org/docs/api/api_key.html.
FRED_API_KEY=
# Glassnode (Crypto/research/archived/sentiment/mvrv/feasibility.py:386) —
# only needed to re-run MVRV / on-chain research. Leave blank in normal use.
GLASSNODE_API_KEY=
