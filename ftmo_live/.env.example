# ftmo_live — variables d'environnement (copier vers le .env du projet, JAMAIS commité)
# Sur le VPS, run_with_env.sh source ~/projects/Algo_claude/.env (pattern S1 sécurité).

# Répertoire MQL5/Files du terminal MT5 FTMO (sous wine sur le VPS), ex:
# /home/algo/.mt5/drive_c/users/algo/AppData/Roaming/MetaQuotes/Terminal/<HASH>/MQL5/Files
FTMO_LIVE_MT5_FILES=

# Telegram (nouveau token POST-rotation — tg.py refuse les tokens blocklistés)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 1 = pas d'envoi réseau (dev/tests)
#FTMO_LIVE_TG_DISABLED=1
