+// ---------------------------------------------------------------------
+// Filtre FOMC (2026-09) — cf. PLAN_DEPLOIEMENT.md.
+// Lit MQL5/Files/fomc_dates.txt (une date YYYY.MM.DD par ligne, "#" = commentaire,
+// lignes vides ignorées) et dit si AUJOURD'HUI (date PARIS, pas TimeCurrent() serveur —
+// cohérent avec ParisDate()/g_anchor_date utilisés partout ailleurs dans l'EA) y figure.
+// Comparaison sur (year,mon,day) entiers, PAS sur une comparaison de chaîne : évite tout
+// bug de séparateur ('.' vs '-') ou de zero-padding entre le fichier et le format natif.
+// Fail-open STRICT : fichier absent, illisible, vide, ou sans aucune ligne parseable =>
+// false (ORB non filtré, comportement actuel) + alerte via SetError (-> state.json
+// last_error -> supervisor.py -> Telegram). Voir démonstration fuseau horaire dans
+// NOTES_IMPLEMENTATION.md : la décision d'entrée (16:00-20:00 Paris) tombe toujours
+// l'après-midi côté US Eastern (jamais près de minuit ET), donc la date Paris à cet
+// instant précis égale la date US Eastern du jour — y compris pendant les 1-3 semaines
+// où le décalage Paris-ET dérive de 6h à 5h (DST US/EU non synchronisés, cf. L56).
+// Appelée 1x/jour (DayRollover) + 1x au redémarrage (OnInit), JAMAIS par tick/OnTimer.
+// ---------------------------------------------------------------------
+bool IsFomcToday()
+  {
+   // ⚠ EFFET DE BORD ASSUME : cette fonction affecte g_fomc_today AVANT tout SetError().
+   // Raison : SetError() appelle WriteState() de maniere SYNCHRONE ; sans cette affectation
+   // prealable, state.json serait ecrit avec la valeur de la VEILLE sur les chemins fail-open
+   // (constat #1 de l'audit independant 2026-09-07). Les appelants re-affectent la valeur de
+   // retour : l'operation est idempotente.
+   int h=FileOpen("fomc_dates.txt", FILE_READ|FILE_TXT|FILE_ANSI|FILE_SHARE_READ);
+   if(h==INVALID_HANDLE)
+     {
+      g_fomc_today=false;
+      SetError("fomc_dates.txt ABSENT/illisible — ORB funded NON filtre (fail-open)");
+      return false;
+     }
+   if(FileSize(h)==0)
+     {
+      FileClose(h);
+      g_fomc_today=false;
+      SetError("fomc_dates.txt VIDE — ORB funded NON filtre (fail-open)");
+      return false;
+     }
+   MqlDateTime p; ParisStruct(p);           // date PARIS au moment de l'appel (rollover/init)
+   bool hit=false;
+   int n_lines=0, n_parsed=0, n_bad=0;
+   string first_bad="";
+   while(!FileIsEnding(h))
+     {
+      string l=FileReadString(h);
+      StringTrimLeft(l); StringTrimRight(l);
+      if(l=="" || StringGetCharacter(l,0)=='#') continue;
+      n_lines++;
+      string parts[];
+      int np=StringSplit(l, '.', parts);
+      bool ok=(np==3);
+      int y=0, m=0, d=0;
+      if(ok)
+        {
+         y=(int)StringToInteger(parts[0]);
+         m=(int)StringToInteger(parts[1]);
+         d=(int)StringToInteger(parts[2]);
+         ok=(y>1900 && m>=1 && m<=12 && d>=1 && d<=31);
+        }
+      if(!ok)
+        {
+         n_bad++;
+         if(first_bad=="") first_bad=l;
+         continue;
+        }
+      n_parsed++;
+      if(y==p.year && m==p.mon && d==p.day) hit=true;
+     }
+   FileClose(h);
+   g_fomc_today=hit;
+   if(n_lines>0 && n_parsed==0)
+      SetError("fomc_dates.txt: aucune ligne parseable (attendu YYYY.MM.DD) — "
+               "ORB funded NON filtre (fail-open)");
+   else if(n_bad>0)
+      SetError(StringFormat("fomc_dates.txt: %d ligne(s) ILLISIBLE(S) ignoree(s), 1re=\"%s\" — "
+                            "%d date(s) valides retenues, calendrier possiblement INCOMPLET",
+                            n_bad, first_bad, n_parsed));
+   return hit;
+  }
